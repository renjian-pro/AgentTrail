<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.agenttrail</groupId>
	<artifactId>agent-trail</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>AgentTrail</name>
	<description>Minimal Agent Loop</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<agentscope.version>2.0.0</agentscope.version>
		<spring-ai.version>2.0.0</spring-ai.version>
		<jsonschema-generator.version>5.0.0</jsonschema-generator.version>
		<tika.version>2.9.2</tika.version>
		<sonar.organization>renjian-pro</sonar.organization>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		<sonar.projectKey>renjian-pro_AgentTrail</sonar.projectKey>
		<sonar.coverage.jacoco.xmlReportPaths>target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
	</properties>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>io.agentscope</groupId>
				<artifactId>agentscope-bom</artifactId>
				<version>${agentscope.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
		</dependency>
		<dependency>
			<groupId>io.opentelemetry</groupId>
			<artifactId>opentelemetry-exporter-otlp</artifactId>
		</dependency>

		<!-- ChatModel / ChatResponse / Message / ToolCallback — 手写 loop 直调 ChatModel.stream，不用 ChatClient -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-client-chat</artifactId>
		</dependency>

		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

		<!-- BeanOutputConverter（issue #18 结构化输出）生成 JSON Schema 靠这个库；spring-ai-bom
		     只把它声明成 optional，不显式加的话运行时才会在第一次调用时炸 NoClassDefFoundError -->
		<dependency>
			<groupId>com.github.victools</groupId>
			<artifactId>jsonschema-generator</artifactId>
			<version>${jsonschema-generator.version}</version>
		</dependency>
		<dependency>
			<groupId>com.github.victools</groupId>
			<artifactId>jsonschema-module-jackson</artifactId>
			<version>${jsonschema-generator.version}</version>
		</dependency>

		<dependency>
			<groupId>io.agentscope</groupId>
			<artifactId>agentscope-core</artifactId>
		</dependency>

		<dependency>
			<groupId>io.agentscope</groupId>
			<artifactId>agentscope-extensions-model-openai</artifactId>
		</dependency>

		<!-- 会话持久化：JdbcClient + MySQL 驱动 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>

		<!-- 数据库迁移工具化：spring.flyway.enabled 默认 false，本地开发/测试继续走既有的
		     spring.sql.init 机制，生产部署首次接入时打开。 -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-mysql</artifactId>
		</dependency>

		<!-- 认证会话：Sa-Token 的 Jakarta/Servlet 适配器兼容当前 Spring Boot 4，
		     Redis DAO 让 token 在多实例部署间共享；数据库仍只保存用户和权限事实。 -->
		<dependency>
			<groupId>cn.dev33</groupId>
			<artifactId>sa-token-spring-boot3-starter</artifactId>
			<version>1.39.0</version>
		</dependency>
		<dependency>
			<groupId>cn.dev33</groupId>
			<artifactId>sa-token-redis-jackson</artifactId>
			<version>1.39.0</version>
		</dependency>
		<!-- 只使用 Spring Security 的独立密码哈希模块，不引入 Filter Chain/认证模型。 -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>

		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- 分布式任务锁（issue #11）：直连 RedissonClient，不用 redisson-spring-boot-starter——
		     这个starter 的自动装配对 Spring Boot 4.x 尚未有明确的兼容声明，手动 new 一个 Config
		     反而更可控，也不依赖 Boot 自动装配是否已经跟上这个大版本 -->
		<dependency>
			<groupId>org.redisson</groupId>
			<artifactId>redisson</artifactId>
			<version>3.51.0</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.3.0</version>
			<scope>test</scope>
		</dependency>

		<!-- V1 生产环境的 ChatModel 供应方——自动装配 DeepSeekChatModel Bean（spring.ai.deepseek.*
		     配置项），替代之前只在 test scope 声明的 spring-ai-deepseek（该依赖已被这个 starter
		     以 compile scope 传递引入，测试代码里用到的 DeepSeekChatOptions 不受影响） -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-deepseek</artifactId>
		</dependency>

		<!-- 多模型路由（issue #20）：Qwen（qwen-plus）走 OpenAI 兼容模式接入 DashScope，
		     不是独立的厂商模块——DashScope 本身提供 OpenAI 兼容端点，直接复用 openai starter -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-openai</artifactId>
		</dependency>

		<!-- 文件问答（issue #21）：统一解析 PDF/Office/HTML/纯文本，不手写 PDFBox+POI 各自的分支——
		     版本对齐参考实现（dodo-agentx）已验证可用的 2.9.2 -->
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-core</artifactId>
			<version>${tika.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-parsers-standard-package</artifactId>
			<version>${tika.version}</version>
		</dependency>
		<!-- tika-core 2.9.2 的 zip 容器探测代码用到了 ChecksumInputStream（commons-io 2.16.0 才有），
		     但它自己声明的传递依赖却是更旧的 2.15.1——不显式提升版本，连 .txt 都解析不了，
		     一上来就是 NoClassDefFoundError -->
		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
			<version>2.18.0</version>
		</dependency>

		<!-- 大文件 RAG 检索问答（issue #26）：向量库 + 查询压缩/多查询扩展，工件名对齐参考实现 -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-rag</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- 联网搜索（issue #22）：Tavily 走 MCP streamable-HTTP -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-mcp-client</artifactId>
		</dependency>
		<!-- spring-ai-mcp:2.0.0 是照着 mcp SDK 2.0.0 编的（McpSchema.Tool.inputSchema() 这类方法
		     只在 2.0.0 里有），但 agentscope-core 传递依赖了更旧的 0.17.0，声明顺序上 Maven
		     "最近优先"选中了旧版本——不显式钉住版本，第一次真正调用 MCP 工具就是
		     NoSuchMethodError，而不是编译期就能发现的问题 -->
		<dependency>
			<groupId>io.modelcontextprotocol.sdk</groupId>
			<artifactId>mcp</artifactId>
			<version>2.0.0</version>
		</dependency>

		<!-- Redis 分布式锁的集成测试用（issue #11），版本交给 spring-boot-dependencies BOM 管理。
		     Testcontainers 2.x 把 JUnit5 扩展模块从 org.testcontainers:junit-jupiter 改名成了
		     org.testcontainers:testcontainers-junit-jupiter，旧坐标在这个大版本下已经没有对应发布 -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- issue #23 图表生成的 MinIO 上传由 mcp-echarts（独立 Node 进程）内置完成，本来只在集成
		     测试里用这个 SDK 独立验证图片真的落进了 bucket；issue #31（AI 配图立即转存 MinIO）
		     第一次由这个 Java 进程的生产代码直接调 MinIO 写入（MinioPptImageStore），scope 从
		     test 提到默认（compile），main 和 test 都用同一个坐标，不需要重复声明两次 -->
		<dependency>
			<groupId>io.minio</groupId>
			<artifactId>minio</artifactId>
			<version>8.5.17</version>
		</dependency>

		<!-- DataAgent 的 SQL 只读安全边界：字符级正则无法可靠处理注释、子查询和函数嵌套，
		     因此安全校验与权限改写统一基于同一个 AST 版本。 -->
		<dependency>
			<groupId>com.github.jsqlparser</groupId>
			<artifactId>jsqlparser</artifactId>
			<version>5.3</version>
		</dependency>

		<!-- 只允许数学表达式的白名单求值器；不要用能执行任意代码的 ScriptEngine。 -->
		<dependency>
			<groupId>net.objecthunter</groupId>
			<artifactId>exp4j</artifactId>
			<version>0.4.8</version>
		</dependency>

	</dependencies>

	<!--
		MySQL 集成测试连的是开发机上常驻的实例（见 com.agenttrail.support.SharedMySql），不用
		Testcontainers 现拉现起容器——这台机器上 Testcontainers 起一个全新 MySQL 要等 initdb
		初始化数据目录，慢到分钟级；直接连常驻实例更快，隔离靠"各自清自己的库/表"。
		同样不用 H2：SQL AST 校验、权限改写这些在 H2 上的行为和 MySQL 不一致，会掩盖真实 bug。

		Redis 集成测试反过来用 Testcontainers（见 RedisTaskLockIT）：Redis 镜像没有 initdb 这一步，
		容器几秒内就绪，起一次性容器的代价不像 MySQL 那么高，换来的是不依赖这台机器上
		"恰好有一个装好的常驻 Redis"这个前提——issue #11 的验收标准也明确要求真实 Redis 而非内存模拟。
	-->

	<build>
		<plugins>
			<!-- 前端与后端一起进入同一个 JAR；开发时仍可在 frontend/ 内独立执行 vite。 -->
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<version>1.15.1</version>
				<configuration>
					<workingDirectory>frontend</workingDirectory>
					<installDirectory>frontend/.mvn-node</installDirectory>
				</configuration>
				<executions>
					<execution><id>install-node-and-npm</id><goals><goal>install-node-and-npm</goal></goals><configuration><nodeVersion>v22.18.0</nodeVersion><npmVersion>10.9.3</npmVersion></configuration></execution>
					<execution><id>npm-install</id><goals><goal>npm</goal></goals><configuration><arguments>install</arguments></configuration></execution>
					<execution><id>npm-build</id><phase>prepare-package</phase><goals><goal>npm</goal></goals><configuration><arguments>run build</arguments></configuration></execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!--
				Surefire 默认只认 *Test/*Tests/*TestCase，不认 *IT —— *IT 是 Failsafe 的命名约定，
				而本项目没接 Failsafe。不显式加上 **/*IT.java，JdbcSessionStoreIT 这类真连 MySQL
				的集成测试会被 mvn test 悄悄跳过，看着全绿实际上根本没跑。
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/*Test.java</include>
						<include>**/*Tests.java</include>
						<include>**/*TestCase.java</include>
					</includes>
					<excludes>
						<exclude>**/*IT.java</exclude>
						<!-- These classes have integration dependencies despite their names. -->
						<exclude>**/AgentTrailApplicationTests.java</exclude>
						<exclude>**/SkillManagerTest.java</exclude>
						<exclude>**/ConversationHistoryServiceTest.java</exclude>
					</excludes>
				</configuration>
			</plugin>

			<!-- JaCoCo：生成覆盖率报告，供 SonarCloud 读取 -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<configuration>
					<!-- JSqlParser ships a generated lexer method larger than JaCoCo can instrument. -->
					<excludes>
						<exclude>net/sf/jsqlparser/**</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<goals><goal>prepare-agent</goal></goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals><goal>report</goal></goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>integration</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<!-- Restore the full test set for an explicitly provisioned environment. -->
							<excludes combine.self="override"/>
							<includes combine.self="override">
								<include>**/*Test.java</include>
								<include>**/*Tests.java</include>
								<include>**/*TestCase.java</include>
								<include>**/*IT.java</include>
							</includes>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>golden</id>
			<properties>
				<agenttrail.golden.enabled>true</agenttrail.golden.enabled>
				<!-- 排查用的两个开关，默认空 = 全量跑、每条等满三分钟。failsafe 是 fork 出去的
				     JVM，命令行上的 -D 不会自动传进去，必须在这里显式转发一遍。 -->
				<agenttrail.golden.cases/>
				<agenttrail.golden.timeout.seconds/>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<version>3.5.3</version>
						<configuration>
							<systemPropertyVariables>
								<agenttrail.golden.enabled>${agenttrail.golden.enabled}</agenttrail.golden.enabled>
								<agenttrail.golden.cases>${agenttrail.golden.cases}</agenttrail.golden.cases>
								<agenttrail.golden.timeout.seconds>${agenttrail.golden.timeout.seconds}</agenttrail.golden.timeout.seconds>
							</systemPropertyVariables>
							<includes>
								<include>**/GoldenTaskIT.java</include>
								<include>**/GoldenTaskLiveIT.java</include>
							</includes>
						</configuration>
						<executions>
							<execution>
								<goals><goal>integration-test</goal><goal>verify</goal></goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
