# 复制为 .env，和 docker-compose.prod.yml 放同一目录（服务器上 /opt/agenttrail/）。
# 这个文件不进 git，密码自己生成随机字符串填，不要用示例里的占位符。

# ACR 仓库的公网地址（域名部分，不带路径），和 GitHub Secrets 里 REGISTRY_URL 填的是同一个值，
# 抄过来就行，形如：crpi-xxxxxxxxxxxx.cn-beijing.personal.cr.aliyuncs.com
# （服务器和 ACR 同地域，理论上换成"专有网络"那个 -vpc 域名拉镜像更快更省流量，
# 但要额外注意专有网络下 docker login 的域名要跟着换，先用公网地址跑通，之后想优化再改）
REGISTRY_URL=

# 对应 GitHub Actions 里推送时打的 tag，通常是某次 commit 的 sha，先填 latest 跑通，
# 后续如果要固定某个版本再改成具体的 sha。
IMAGE_TAG=latest

MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
