# 复制为 secrets.properties 后填写本机值。secrets.properties 已被 Git 忽略。
# 不使用的可选能力可以留空；不要把任何真实值写回本示例文件。

# 模型与搜索 API 密钥
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
TAVILY_API_KEY=

# 本地 MySQL
AGENTTRAIL_DB_URL=
AGENTTRAIL_DB_USERNAME=
AGENTTRAIL_DB_PASSWORD=

# 本地 PgVector/Postgres
AGENTTRAIL_PGVECTOR_URL=
AGENTTRAIL_PGVECTOR_USERNAME=
AGENTTRAIL_PGVECTOR_PASSWORD=

# 本地 MinIO（图表与 PPT 图片共用连接，bucket 分开配置）
AGENTTRAIL_MINIO_ENDPOINT=
AGENTTRAIL_MINIO_ACCESS_KEY=
AGENTTRAIL_MINIO_SECRET_KEY=
AGENTTRAIL_MINIO_BUCKET=agenttrail-charts
AGENTTRAIL_PPT_IMAGE_MINIO_BUCKET=agenttrail-ppt-images

# 本地 MCP 服务
MCP_ECHARTS_URL=
